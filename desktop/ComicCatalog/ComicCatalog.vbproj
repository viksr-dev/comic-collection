<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <StartupObject>ComicCatalog.Program</StartupObject>
    <RootNamespace>ComicCatalog</RootNamespace>
    <AssemblyName>ComicCatalog</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <Product>Comic Catalog</Product>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Lets the project also build on Mac or Linux; it only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The screens are built in code, not the Visual Studio designer, so the designer's property check doesn't apply. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Newer SQLite engine than Microsoft.Data.Sqlite brings by default (security fix GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <!-- Opens CBZ/CBR/CB7 comic files (MIT). -->
    <PackageReference Include="SharpCompress" Version="0.50.5" />
    <!-- Draws PDF comic pages (PDFium). -->
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\database\schema.sql" LogicalName="schema.sql" />
    <EmbeddedResource Include="..\database\sample-data.sql" LogicalName="sample-data.sql" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
