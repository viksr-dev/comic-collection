<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks the database code without Windows. Run: dotnet run (in this folder) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ComicCatalog</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <!-- Newer SQLite engine than Microsoft.Data.Sqlite brings by default (security fix GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <Compile Include="..\ComicCatalog\Data\*.vb" Link="Data\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\database\schema.sql" LogicalName="schema.sql" />
    <EmbeddedResource Include="..\database\sample-data.sql" LogicalName="sample-data.sql" />
  </ItemGroup>
</Project>
