<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks the database code without Windows. Run: dotnet run (in this folder) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ComicCatalog</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <Compile Include="..\ComicCatalog\Data\*.vb" Link="Data\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\database\schema.sql" LogicalName="schema.sql" />
    <EmbeddedResource Include="..\database\sample-data.sql" LogicalName="sample-data.sql" />
  </ItemGroup>
</Project>
